# Salin ke environment variable di hosting Anda (jangan commit nilai asli ke GitHub).
# Di hosting: isi sebagai Environment Variable, BUKAN dengan mengunggah file .env.

# ===== WAJIB untuk Global Leaderboard =====
# Salin connection string dari Neon / Supabase / dll. Contoh bentuk (ini CONTOH, ganti dengan milik Anda):
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ===== Opsional =====
# SSL otomatis: aktif untuk database online, mati untuk localhost. Isi hanya jika perlu dipaksa:
# DATABASE_SSL=true
# Kunci penanda token login, minimal 16 karakter acak. Kosong = dibuat otomatis & disimpan di database.
AUTH_SECRET=
# true = server menolak jalan jika DATABASE_URL belum benar (default: game tetap jalan, leaderboard nonaktif)
REQUIRE_DATABASE=false
# Batas anti-curang (nilai bawaan ditampilkan)
MIN_ROUND_SECONDS=30
TOURNAMENT_MIN_HUMANS=2
MAX_TOURNAMENTS_PER_HOUR=12
MAX_TOURNAMENTS_PER_DAY=100
# Database gratis punya sedikit koneksi: turunkan jika muncul "too many connections"
DATABASE_POOL_MAX=5
